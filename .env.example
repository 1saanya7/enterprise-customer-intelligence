# Copy to .env. The private workspace uses fictional sample data and offline calculations.
# No-paid-cloud policy: configuring a project/model DOES NOT unlock cloud execution.
APP_MODE=local
DATA_PATH=.local/northstar-v2.sqlite3
BOOTSTRAP_PASSWORD=
# Required for live Gemini synthesis; use Application Default Credentials, not keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=
# Live cloud entry points stay disabled until real identity and source ACLs are configured.
